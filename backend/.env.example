SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PORT=3333

# E-mail transacional (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE=Andrade Energy <faturas@seudominio.com.br>

# Recebimento automático de contas de energia (Resend Inbound)
# O domínio deve ser um subdomínio verificado, por exemplo receber.seudominio.com.br.
RESEND_INBOUND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_MAX_BYTES=10485760

# Conexão segura com a caixa de e-mail do cliente (OAuth + PKCE)
# Use uma chave estável de 32 bytes. No Windows com Node instalado, por exemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENCRYPTION_KEY=
# URL pública HTTPS do backend, sem barra final. Ex.: https://andrade-energy-api.onrender.com
OAUTH_PUBLIC_BASE_URL=
# Deep links usados ao concluir a autorização no navegador (opcionais; há valores padrão no app)
OAUTH_APP_CALLBACK_CONSUMIDOR=andradeenergyconsumidor://email-conectado
OAUTH_APP_CALLBACK_GERADOR=andradeenergygerador://email-conectado
# Credenciais de aplicativos web confidenciais. Nunca use ou exponha no aplicativo móvel.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Hotmail/Outlook pessoal (alternativa gratuita ao Resend)
MICROSOFT_CLIENT_ID=
MICROSOFT_TOKEN_CACHE_BASE64=

# Brevo (opção gratuita com remetente Hotmail verificado)
BREVO_API_KEY=
BREVO_REMETENTE_EMAIL=andradeenergy@hotmail.com
BREVO_REMETENTE_NOME=Andrade Energy

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=fatura_disponivel
WHATSAPP_GRAPH_VERSION=
