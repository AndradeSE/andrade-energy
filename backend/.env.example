SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PORT=3333

# E-mail transacional (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE=Andrade Energy <faturas@seudominio.com.br>

# Recebimento automático de contas de energia (Resend Inbound)
# O domínio deve ser um subdomínio verificado, por exemplo receber.seudominio.com.br.
RESEND_INBOUND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_MAX_BYTES=10485760

# Hotmail/Outlook pessoal (alternativa gratuita ao Resend)
MICROSOFT_CLIENT_ID=
MICROSOFT_TOKEN_CACHE_BASE64=

# Brevo (opção gratuita com remetente Hotmail verificado)
BREVO_API_KEY=
BREVO_REMETENTE_EMAIL=andradeenergy@hotmail.com
BREVO_REMETENTE_NOME=Andrade Energy

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=fatura_disponivel
WHATSAPP_GRAPH_VERSION=
